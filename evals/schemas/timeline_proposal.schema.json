{
  "type": "object",
  "required": [
    "date",
    "needs_clarification",
    "clarification_questions",
    "blocks",
    "total_hours",
    "validation_state"
  ],
  "properties": {
    "date": { "type": "string" },
    "needs_clarification": { "type": "boolean" },
    "clarification_questions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "description",
          "start",
          "end",
          "hours",
          "confidence",
          "is_constraint",
          "project_key",
          "category"
        ],
        "properties": {
          "label": { "type": "string" },
          "description": { "type": "string" },
          "start": { "type": "string" },
          "end": { "type": "string" },
          "hours": { "type": "number" },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "is_constraint": { "type": "boolean" },
          "project_key": { "type": ["string", "null"] },
          "category": {
            "type": "string",
            "enum": [
              "development",
              "review",
              "meeting",
              "planning",
              "operations",
              "communication",
              "other"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "total_hours": { "type": "number" },
    "validation_state": { "type": "string" }
  },
  "additionalProperties": false
}
